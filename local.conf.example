# /opt/hound-coder/local.conf
# Host-specific nginx overrides. Copy this file to /opt/hound-coder/local.conf and edit — NOT tracked in git.

listen 80;
server_name localhost;

# Once TLS certs are available (certbot, acme.sh, self-signed, etc.), add something like:
