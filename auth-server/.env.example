# Copy this file to auth-server/.env and fill in real values. Not tracked in git.

# OAuth client from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: https://<your-host>/register/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Only Google accounts with this email domain may self-register
ALLOWED_EMAIL_DOMAIN=example.edu
