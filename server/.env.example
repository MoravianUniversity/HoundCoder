# Copy this file to server/.env and fill in real values. Not tracked in git.

# Display name on the welcome page and in API metadata (default: Hound Coder)
# SERVICE_NAME=Hound Coder

# OAuth client from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: https://<your-host>/register/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Only Google accounts with this email domain may self-register (also shown on the welcome page)
ALLOWED_EMAIL_DOMAIN=example.edu

# Optional: how long to keep per-request audit rows in usage.db (days; default 182)
# USAGE_RETENTION_DAYS=182

# Optional: override local vLLM OpenAI bases used by the inference proxy
# TAB_UPSTREAM=http://127.0.0.1:8001/v1
# CHAT_UPSTREAM=http://127.0.0.1:8002/v1

# Set to 1 when clients reach the site over HTTPS (TLS at nginx). Marks the
# OAuth session cookie Secure. Leave unset for plain HTTP / local setups.
# COOKIE_SECURE=1
